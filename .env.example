# Copy to .env.local and replace every placeholder with your own values.
# Never commit .env.local or expose server-only keys.

# Admin dashboard credentials (server-only)
ADMIN_USERNAME=replace-with-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# PostgreSQL (Supabase-hosted PostgreSQL is supported; use the pooler URL at runtime)
DATABASE_URL=postgresql://postgres.project-ref:URL-ENCODED-PASSWORD@aws-1-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.project-ref:URL-ENCODED-PASSWORD@aws-1-region.pooler.supabase.com:5432/postgres
